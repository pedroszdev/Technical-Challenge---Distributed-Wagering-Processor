{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "infra:up": "docker compose up -d --wait postgres sqs && docker compose up sqs-init",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "orm": "bun --bun --env-file=.env mikro-orm",
    "migration:create": "bun --bun --env-file=.env mikro-orm migration:create",
    "migration:up": "bun --bun --env-file=.env mikro-orm migration:up",
    "migration:down": "bun --bun --env-file=.env mikro-orm migration:down",
    "migration:list": "bun --bun --env-file=.env mikro-orm migration:list"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/infrastructure/database/mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1168.0",
    "@mikro-orm/core": "^7.2.9",
    "@mikro-orm/migrations": "^7.2.9",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.9",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.9",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
